{
  "name": "ecom-price-tracker",
  "version": "1.0.0",
  "description": "E-commerce price & stock tracker with alerts",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "scrape": "node src/scraper/run.ts",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:install": "playwright install --with-deps",
    "test:upload-b2": "node --test --experimental-strip-types src/tests/upload-b2.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start:prod": "node dist/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "dotenv": "^17.4.2",
    "mongodb": "^7.5.0",
    "node-cron": "^4.6.0",
    "playwright": "^1.62.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.1",
    "@types/node-cron": "^3.0.11",
    "typescript": "^7.0.2"
  }
}
