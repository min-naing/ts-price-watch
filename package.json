{
  "name": "ecom-price-tracker",
  "version": "1.0.0",
  "description": "E-commerce price & stock tracker with alerts",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "scrape": "node src/scraper/run.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:install": "playwright install --with-deps",
    "test:smoke:upload-b2": "vitest run src/tests/smoke/upload-b2.smoke.test.ts",
    "test:smoke:telegram": "vitest run src/tests/smoke/telegram.smoke.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start:prod": "node dist/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "dotenv": "^17.4.2",
    "mongodb": "^7.5.0",
    "playwright": "^1.62.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
